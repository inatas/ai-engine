DATABASE_URL=postgresql://ai_engine:ai_engine_local@127.0.0.1:55433/ai_engine
AI_ENGINE_DB_PORT=55433
PORT=3000
AUTH_ORIGIN=http://127.0.0.1:5173
# 至少 32 随机字节的 base64url 编码，不能使用此空值；参见 README。
CSRF_SECRET=
# 默认不信任转发头；反向代理部署填写明确 IP，逗号分隔。
TRUSTED_PROXY_IPS=

# 作者侧模型服务：填写 HTTPS 服务地址，不是控制台网页地址。
# OpenAI 兼容 Chat Completions：填写服务根地址（如 https://你的服务/v1）或完整 /chat/completions 接口。
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
